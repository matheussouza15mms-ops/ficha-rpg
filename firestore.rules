rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return isSignedIn() && request.auth.token.email in [
        "matheus.souza15.mms@gmail.com"
      ];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isMaster());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /characters/{characterId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isMaster());
      // O mestre cria fichas em nome do jogador cuja ficha está aberta, então o
      // ownerId do documento novo pode ser de outro usuário. Isso acompanha as
      // permissões de update/delete, que o mestre já possui sobre qualquer ficha.
      allow create: if isSignedIn()
        && (request.resource.data.ownerId == request.auth.uid || isMaster());
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isMaster());
    }

    // Contador dos números de retrato (counters/characterPortrait). Só pode
    // crescer: um número já entregue a uma ficha nunca volta a ser sorteado,
    // então excluir personagem não faz outro herdar a imagem dele.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.lastPortraitNumber is int
        && request.resource.data.lastPortraitNumber > 0;
      allow update: if isSignedIn() && request.resource.data.lastPortraitNumber is int
        && request.resource.data.lastPortraitNumber > resource.data.lastPortraitNumber;
    }
  }
}
